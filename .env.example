# Local development values only. Copy to .env (git-ignored) and change them.
# In production these come from a secret manager, never from files in the repo.

# Profiles database: users, names, phone numbers, addresses.
POSTGRES_USER=rolodex
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=rolodex

# Streaming-replication account the read replica of the profiles database
# uses to follow the primary. The API reads profiles from the replica.
REPLICATION_USER=rolodex_replicator
REPLICATION_PASSWORD=change-me-replication-password

# Credentials database: usernames and password hashes. A separate PostgreSQL
# server with its own account, so the profiles credentials above cannot read it.
CREDENTIALS_DB_USER=rolodex_auth
CREDENTIALS_DB_PASSWORD=change-me-credentials-db-password
CREDENTIALS_DB_NAME=rolodex_credentials

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-32-plus-byte-secret

# Password assigned to all seeded demo users (admin, ada, grace, alan, katherine).
SEED_PASSWORD=change-me-demo-password

# Service credentials Rolodex uses against the (mock) vendors' /auth endpoints.
ABC_USERNAME=rolodex-abc
ABC_PASSWORD=change-me-abc-service-secret
XYC_USERNAME=rolodex-xyc
XYC_PASSWORD=change-me-xyc-service-secret

# Fraction of XYC /identity calls that return 503, to exercise retries.
XYC_FAILURE_RATE=0.3

# Optional "Sign in with Google" through Firebase Authentication. Leave empty
# to keep it off. The API verifies ID tokens with only the project ID (no
# service account), and admits verified Google emails on the allowlist below,
# creating their Rolodex user on first sign-in. Setting a project without an
# allowlist is refused at startup.
FIREBASE_PROJECT_ID=
# Comma-separated exact addresses and/or whole domains (e.g. example.com).
# FIREBASE_ALLOWED_DOMAINS=* admits any verified Google account.
FIREBASE_ALLOWED_EMAILS=
FIREBASE_ALLOWED_DOMAINS=
# Public web-app config from Firebase console > Project settings > Your apps.
# These identify the app and are not secrets, but they stay out of the repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
