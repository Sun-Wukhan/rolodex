# Local development values only. Copy to .env (git-ignored) and change them.
# In production these come from a secret manager, never from files in the repo.

POSTGRES_USER=rolodex
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=rolodex

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-32-plus-byte-secret

# Password assigned to all seeded demo users (admin, ada, grace, alan, katherine).
SEED_PASSWORD=change-me-demo-password

# Service credentials Rolodex uses against the (mock) vendors' /auth endpoints.
ABC_USERNAME=rolodex-abc
ABC_PASSWORD=change-me-abc-service-secret
XYC_USERNAME=rolodex-xyc
XYC_PASSWORD=change-me-xyc-service-secret

# Fraction of XYC /identity calls that return 503, to exercise retries.
XYC_FAILURE_RATE=0.3
